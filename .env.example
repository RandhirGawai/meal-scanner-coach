# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values.
# Get a FREE Groq API key (no credit card) at: https://console.groq.com/keys
# ---------------------------------------------------------------------------

GROQ_API_KEY=your_groq_api_key_here

# Model names (Groq's lineup changes periodically — update here if a model
# gets deprecated; check https://console.groq.com/docs/models for the latest).
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Optional: fully offline mode using local Ollama instead of Groq.
# Set USE_OLLAMA_FALLBACK=true and make sure `ollama serve` is running with
# a vision model (e.g. `ollama pull llava`) and a text model (e.g. `ollama pull llama3.1`) pulled.
# ---------------------------------------------------------------------------
USE_OLLAMA_FALLBACK=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_TEXT_MODEL=llama3.1
